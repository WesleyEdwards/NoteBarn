{
    "resource": {
        "aws_sns_topic": {
            "emergency": {
                "name": "notebarn_emergencies"
            }
        },
        "aws_cloudwatch_metric_alarm": {
            "notebarnlambdaspend7d": {
                "alarm_name": "notebarn_notebarnlambdaspend7d",
                "period": 604800,
                "statistic": "Sum",
                "alarm_actions": [
                    "${aws_sns_topic.emergency.arn}"
                ],
                "threshold": 41999916,
                "datapoints_to_alarm": 1,
                "insufficient_data_actions": [],
                "metric_name": "Duration",
                "evaluation_periods": 1,
                "alarm_description": "Notebarn Lambda Spend (7d)",
                "comparison_operator": "GreaterThanOrEqualToThreshold",
                "namespace": "AWS/Lambda",
                "dimensions": {
                    "FunctionName": "${aws_lambda_function.main.function_name}"
                }
            },
            "notebarnlambdaspend1h": {
                "alarm_name": "notebarn_notebarnlambdaspend1h",
                "period": 3600,
                "statistic": "Sum",
                "alarm_actions": [
